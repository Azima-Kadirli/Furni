@using Furni.ViewModels.BlogViewModels
@model BlogCreateViewModel
@{
    ViewData["Title"] = "Create Blog";
}

<div class="container">
    <div class="row">
        <h2>Create Blog</h2>
        <form asp-area="admin" method="post" asp-action="Create" asp-controller="Blog" enctype="multipart/form-data">

            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" placeholder="Title" />
                <span class="text-danger" asp-validation-for="Title"></span>
            </div>

            <div class="form-group">
                <label asp-for="Text"></label>
                <textarea asp-for="Text" class="form-control" placeholder="Text"></textarea>
                <span class="text-danger" asp-validation-for="Text"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImageName"></label>
                <input asp-for="ImageName" type="file" class="form-control" placeholder="ImageName" />
                <span class="text-danger" asp-validation-for="ImageName"></span>
            </div>

            <div class="form-group">
                <label asp-for="EmployeeId"></label>
                <select asp-for="EmployeeId" class="form-control">
                    <option value="">Seçin...</option>
                    @if (ViewBag.Employees != null)
                    {
                        foreach (var emp in ViewBag.Employees)
                        {
                            <option value="@emp.Id">@emp.FirstName</option>
                        }
                    }
                </select>
                <span class="text-danger" asp-validation-for="EmployeeId"></span>
            </div>

            <div class="form-group">
                <label asp-for="TagIds"></label>
                <select asp-for="TagIds" id="TagIds">
                    <option value="" disabled selected>Tag seçin</option>
                    @if (ViewBag.Tags != null)
                    {
                        foreach (var tag in ViewBag.Tags)
                        {
                            <option value="@tag.Id">@tag.Name</option>
                        }
                    }
                </select>
                <span class="text-danger" asp-validation-for="TagIds"></span>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>

