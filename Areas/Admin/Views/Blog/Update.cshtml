@using Furni.ViewModels.BlogViewModels
@model BlogUpdateViewModel
<div class="container">
    <div class="row">
        <form method="post" asp-action="Update" asp-controller="Blog">

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Text"></label>
                <input asp-for="Text" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl"></label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="ImageName"></label>
                <input asp-for="ImageName" class="form-control" />
            </div>
            
            <div class="form-group">
                <label asp-for="TagIds"></label>
                <select asp-for="TagIds" id="TagIds">
                    <option value="null" disabled selected>Tag secin</option>
                    @foreach (Tag tag in ViewBag.Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="TagIds"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
        </form>
    </div>
</div>
