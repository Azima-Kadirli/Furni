@using Furni.ViewModels.BlogViewModels
@model List<BlogGetViewModel>

<div class="container">
    <div class="row">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Text</th>
                    <th>PostDate</th>
                    <th>Image</th>
                    <th>Employee</th>
                    <th>Tags</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var blog in Model)
                {
                    <tr>
                        <td>@blog.Id</td>
                        <td>@blog.Title</td>
                        <td>@blog.Text</td>
                        <td>@blog.PostDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(blog.ImageName))
                            {
                                <img src="@blog.ImageName" alt="@blog.Title" style="width:100px;" />
                            }
                        </td>
                        <td>@blog.Employee.FirstName</td>
                        <td>@string.Join(", ", blog.TagNames)</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@blog.Id" class="btn btn-warning">Update</a>
                            <a asp-action="Delete" asp-route-id="@blog.Id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
