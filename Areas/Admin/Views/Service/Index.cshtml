@using Furni.ViewModels.ServiceViewModel
@model List<ServiceIndexViewModel>
<div class="container">
    <div class="row">
        <table class="table">
            <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
                <th scope="col">ImageName</th>
                <th scope="col">ImageUrl</th>
            </tr>
            </thead>
            <tbody>
            @foreach(var service in Model){
                <tr>
                    <th scope="row">@service.Id</th>
                    <td>@service.Name</td>
                    <td>@service.Description</td>
                    <td>@service.ImageName</td>
                    <td>@service.ImageUrl</td>
                    <td>
                        <a asp-action="Update" asp-route-id="@service.Id" class="btn btn-warning">Update</a>
                        <a asp-action="Delete" asp-route-id="@service.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

</div>